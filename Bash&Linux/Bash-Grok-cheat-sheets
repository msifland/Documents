1. Parameter Expansion Magic
var="/path/to/dir/"          # example string

# Remove trailing slash (any number, shortest match)
echo "${var%/}"              # → /path/to/dir

# Remove trailing slash (greedy, removes everything after last /)
echo "${var%%/*}"            # → (empty if it starts with /)

# Remove leading slash (shortest match)
echo "${var#/}"              # → path/to/dir/

# Remove leading slash, greedy (removes everything up to last /)
echo "${var##*/}"            # → dir/

# Remove both leading and trailing slashes in one go
clean="${var#/}"             # strip leading
clean="${clean%/}"           # strip trailing
echo "$clean"                # → path/to/dir

# One-liner version of the above (my favorite)
clean="${var#/}" ; clean="${clean%/}"
# or even:
clean="${var#"/"}" ; clean="${clean%"/"}"


filename="archive.tar.gz"
echo "${filename%.tar.gz}"   # → archive
echo "${filename%%.*}"       # → archive           (greedy)
echo "${filename#*.}"        # → tar.gz
echo "${filename##*.}"       # → gz                (last extension)

${var#pattern}    # Strip shortest match from LEFT
${var##pattern}   # Strip longest match from LEFT
${var%pattern}    # Strip shortest match from RIGHT
${var%%pattern}   # Strip longest match from RIGHT

${var/pattern/repl}   # Replace first occurrence
${var//pattern/repl}  # Replace ALL occurrences
${var/#pattern/repl}  # Replace only if at beginning
${var/%pattern/repl}  # Replace only if at end

${var:-default}   # Use default if var empty or unset
${var:=default}   # Use default AND assign it if empty
${var:+value}     # Use value only if var is set and non-empty
${var:?message}   # Die with message if empty/unset
